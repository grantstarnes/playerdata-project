[Unit]
Description=PlayerData FastAPI
Documentation=https://github.com/grantstarnes/playerdata
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
User=doorknob
Group=doorknob
WorkingDirectory=/home/doorknob/apps/playerdata/DE/backend
EnvironmentFile=/home/doorknob/apps/playerdata/DE/backend/.env
ExecStart=/home/doorknob/.local/bin/uv run uvicorn app.main:app --host 0.0.0.0 --port 8000 --proxy-headers
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
