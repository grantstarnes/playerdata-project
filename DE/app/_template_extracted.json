t-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"cbf7eed1-6c64-4ed9-a234-aa92d54eb080\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'JetBrains Mono';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"9505e07a-7547-4a14-8aec-fa4835178aee\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'JetBrains Mono';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"51f5f7bc-1d7e-4316-9953-bdc19630dbbc\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* cyrillic-ext */\n@font-face {\n  font-family: 'JetBrains Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"93a52c9b-a448-40ee-9f61-b074914f9bf3\") format('woff2');\n  unicode-range: U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F;\n}\n/* cyrillic */\n@font-face {\n  font-family: 'JetBrains Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"4c4e6d69-0b82-4806-9eba-d7ff3e28ea9c\") format('woff2');\n  unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;\n}\n/* greek */\n@font-face {\n  font-family: 'JetBrains Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"be14d384-59b7-4cd8-acb1-7c6a3c784fd4\") format('woff2');\n  unicode-range: U+0370-0377, U+037A-037F, U+0384-038A, U+038C, U+038E-03A1, U+03A3-03FF;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'JetBrains Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"cbf7eed1-6c64-4ed9-a234-aa92d54eb080\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'JetBrains Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"9505e07a-7547-4a14-8aec-fa4835178aee\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'JetBrains Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"51f5f7bc-1d7e-4316-9953-bdc19630dbbc\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n\n\n:root {\n  /* --- Brand ---------------------------------------------------------- */\n  --pd-green:        #38D830;   /* Signal Green — THE accent */\n  --pd-green-600:    #2BB823;   /* hover */\n  --pd-green-700:    #1F9A19;   /* pressed */\n  --pd-green-50:     #E8FAE6;   /* subtle wash (used sparingly) */\n  --pd-green-ring:   rgba(56,216,48,0.25);\n\n  /* --- Neutrals ------------------------------------------------------- */\n  --pd-black:        #0A0A0A;   /* near-black */\n  --pd-ink-900:      #111418;\n  --pd-ink-700:      #2A2F36;\n  --pd-ink-500:      #4B5563;\n  --pd-ink-400:      #6B7280;\n  --pd-ink-300:      #9CA3AF;\n  --pd-ink-200:      #D1D5DB;\n  --pd-ink-100:      #E5E7EA;\n  --pd-ink-50:       #F0F2F4;\n  --pd-bg:           #F5F6F7;\n  --pd-surface:      #FFFFFF;\n\n  /* --- Foreground semantic ------------------------------------------- */\n  --fg-1: var(--pd-black);       /* primary text, numbers, headings */\n  --fg-2: var(--pd-ink-700);     /* body, labels */\n  --fg-3: var(--pd-ink-400);     /* secondary, captions */\n  --fg-4: var(--pd-ink-300);     /* tertiary, placeholder */\n  --fg-inv: #FFFFFF;\n\n  /* --- Background semantic ------------------------------------------- */\n  --bg-app:     var(--pd-bg);\n  --bg-surface: var(--pd-surface);\n  --bg-sunken:  var(--pd-ink-50);\n  --bg-inverse: var(--pd-black);\n\n  /* --- Status -------------------------------------------------------- */\n  --status-success: var(--pd-green);\n  --status-warn:    #FFB020;\n  --status-error:   #E5484D;\n  --status-info:    #4CC9F0;\n\n  /* --- Chart palette (Plotly-parity from DE/pipeline/visuals.py) ----- */\n  --chart-1: var(--pd-green);    /* your athlete / primary series */\n  --chart-2: #4CC9F0;             /* cohort / comparison */\n  --chart-3: #F72585;             /* negative deltas / decel */\n  --chart-4: #7209B7;             /* sprint distance */\n  --chart-5: #FFB020;             /* load spikes / warning */\n  --chart-6: #0A0A0A;             /* emphasis / median line */\n  --chart-grid: #E5E7EA;\n\n  /* --- Spacing (4-based) --------------------------------------------- */\n  --sp-0: 0;\n  --sp-1: 4px;\n  --sp-2: 8px;\n  --sp-3: 12px;\n  --sp-4: 16px;\n  --sp-5: 24px;\n  --sp-6: 32px;\n  --sp-7: 48px;\n  --sp-8: 64px;\n  --sp-9: 96px;\n\n  /* --- Radii --------------------------------------------------------- */\n  --r-sm:   6px;\n  --r-md:  10px;\n  --r-lg:  14px;\n  --r-xl:  20px;\n  --r-full: 999px;\n\n  /* --- Shadows ------------------------------------------------------- */\n  --shadow-xs:    0 1px 2px rgba(10,10,10,0.04);\n  --shadow-sm:    0 2px 8px rgba(10,10,10,0.06);\n  --shadow-md:    0 8px 24px rgba(10,10,10,0.08);\n  --shadow-lg:    0 16px 48px rgba(10,10,10,0.12);\n  --shadow-focus: 0 0 0 3px var(--pd-green-ring);\n\n  /* --- Type families ------------------------------------------------- */\n  --font-display: 'Archivo', ui-sans-serif, system-ui, sans-serif;\n  --font-body:    'Inter', ui-sans-serif, system-ui, sans-serif;\n  --font-mono:    'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;\n\n  /* --- Type scale (values / line-height) ----------------------------- */\n  --fs-display: 48px;  --lh-display: 1.02;  /* KPI giant */\n  --fs-h1: 32px;       --lh-h1: 1.12;\n  --fs-h2: 24px;       --lh-h2: 1.18;\n  --fs-h3: 18px;       --lh-h3: 1.25;\n  --fs-h4: 15px;       --lh-h4: 1.35;\n  --fs-body: 14px;     --lh-body: 1.5;\n  --fs-body-lg: 16px;  --lh-body-lg: 1.5;\n  --fs-label: 12px;    --lh-label: 1.35;   /* uppercase or sentence */\n  --fs-caption: 11px;  --lh-caption: 1.3;\n\n  /* --- Durations ------------------------------------------------------ */\n  --dur-fast:   120ms;\n  --dur-med:    200ms;\n  --dur-modal:  320ms;\n  --dur-sheet:  450ms;\n  --ease-out:   cubic-bezier(.16,1,.3,1);\n  --ease-in:    cubic-bezier(.7,0,.84,0);\n}\n\n/* =========================================================================\n   Base\n   ========================================================================= */\n\n*, *::before, *::after { box-sizing: border-box; }\n\nhtml, body {\n  margin: 0;\n  padding: 0;\n  background: var(--bg-app);\n  color: var(--fg-1);\n  font-family: var(--font-body);\n  font-size: var(--fs-body);\n  line-height: var(--lh-body);\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n  font-feature-settings: \"ss01\", \"cv11\";\n}\n\n/* Tabular nums wherever numbers live */\n.num, th, td, .kpi, .metric, [data-tabular] {\n  font-variant-numeric: tabular-nums;\n}\n\n/* =========================================================================\n   Semantic element styles\n   ========================================================================= */\n\nh1, .pd-h1 {\n  font-family: var(--font-display);\n  font-weight: 700;\n  font-size: var(--fs-h1);\n  line-height: var(--lh-h1);\n  letter-spacing: -0.02em;\n  color: var(--fg-1);\n  margin: 0 0 var(--sp-4);\n}\n\nh2, .pd-h2 {\n  font-family: var(--font-display);\n  font-weight: 700;\n  font-size: var(--fs-h2);\n  line-height: var(--lh-h2);\n  letter-spacing: -0.015em;\n  color: var(--fg-1);\n  margin: 0 0 var(--sp-3);\n}\n\nh3, .pd-h3 {\n  font-family: var(--font-display);\n  font-weight: 600;\n  font-size: var(--fs-h3);\n  line-height: var(--lh-h3);\n  letter-spacing: -0.005em;\n  color: var(--fg-1);\n  margin: 0 0 var(--sp-2);\n}\n\nh4, .pd-h4 {\n  font-family: var(--font-body);\n  font-weight: 600;\n  font-size: var(--fs-h4);\n  line-height: var(--lh-h4);\n  color: var(--fg-1);\n  margin: 0 0 var(--sp-2);\n}\n\np, .pd-p {\n  font-size: var(--fs-body);\n  line-height: var(--lh-body);\n  color: var(--fg-2);\n  margin: 0 0 var(--sp-3);\n  text-wrap: pretty;\n}\n\n.pd-kpi {\n  font-family: var(--font-display);\n  font-weight: 700;\n  font-size: var(--fs-display);\n  line-height: var(--lh-display);\n  letter-spacing: -0.03em;\n  color: var(--fg-1);\n  font-variant-numeric: tabular-nums;\n}\n\n.pd-kpi-unit {\n  font-family: var(--font-body);\n  font-weight: 500;\n  font-size: var(--fs-label);\n  color: var(--fg-3);\n  margin-left: 4px;\n}\n\n.pd-label {\n  font-family: var(--font-body);\n  font-weight: 500;\n  font-size: var(--fs-label);\n  line-height: var(--lh-label);\n  color: var(--fg-3);\n  letter-spacing: 0.02em;\n}\n\n.pd-label-caps {\n  font-family: var(--font-body);\n  font-weight: 600;\n  font-size: 11px;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--fg-3);\n}\n\n.pd-caption {\n  font-size: var(--fs-caption);\n  line-height: var(--lh-caption);\n  color: var(--fg-3);\n}\n\ncode, .pd-mono {\n  font-family: var(--font-mono);\n  font-size: 12.5px;\n  color: var(--fg-2);\n  background: var(--bg-sunken);\n  padding: 1px 6px;\n  border-radius: var(--r-sm);\n}\n\n/* =========================================================================\n   Cards + surfaces\n   ========================================================================= */\n\n.pd-card {\n  background: var(--bg-surface);\n  border: 1px solid var(--pd-ink-100);\n  border-radius: var(--r-lg);\n  box-shadow: var(--shadow-xs);\n  padding: var(--sp-5);\n}\n\n.pd-card-sm { border-radius: var(--r-md); padding: var(--sp-4); }\n\n.pd-divider { height: 1px; background: var(--pd-ink-100); border: 0; margin: var(--sp-4) 0; }\n\n/* =========================================================================\n   Buttons\n   ========================================================================= */\n\n.pd-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  font-family: var(--font-body);\n  font-weight: 600;\n  font-size: var(--fs-body);\n  line-height: 1;\n  height: 40px;\n  padding: 0 16px;\n  border-radius: var(--r-md);\n  border: 1px solid transparent;\n  cursor: pointer;\n  transition: background var(--dur-fast) var(--ease-out),\n              color var(--dur-fast) var(--ease-out),\n              border-color var(--dur-fast) var(--ease-out),\n              box-shadow var(--dur-fast) var(--ease-out);\n  white-space: nowrap;\n}\n.pd-btn:focus-visible { outline: none; box-shadow: var(--shadow-focus); }\n\n.pd-btn--primary {\n  background: var(--pd-green);\n  color: var(--pd-black);\n}\n.pd-btn--primary:hover { background: var(--pd-green-600); }\n.pd-btn--primary:active { background: var(--pd-green-700); }\n\n.pd-btn--secondary {\n  background: var(--bg-surface);\n  color: var(--fg-1);\n  border-color: var(--pd-ink-200);\n}\n.pd-btn--secondary:hover { background: var(--pd-ink-50); }\n\n.pd-btn--ghost {\n  background: transparent;\n  color: var(--fg-2);\n}\n.pd-btn--ghost:hover { background: var(--pd-ink-50); color: var(--fg-1); }\n\n.pd-btn--dark {\n  background: var(--pd-black);\n  color: #fff;\n}\n.pd-btn--dark:hover { background: var(--pd-ink-900); }\n\n.pd-btn--sm { height: 32px; padding: 0 12px; font-size: 13px; border-radius: var(--r-sm); }\n.pd-btn--lg { height: 48px; padding: 0 20px; font-size: 15px; }\n\n/* =========================================================================\n   Inputs\n   ========================================================================= */\n\n.pd-input {\n  width: 100%;\n  height: 40px;\n  padding: 0 12px;\n  background: var(--bg-surface);\n  border: 1px solid var(--pd-ink-200);\n  border-radius: var(--r-md);\n  color: var(--fg-1);\n  font-family: var(--font-body);\n  font-size: var(--fs-body);\n  transition: border-color var(--dur-fast) var(--ease-out),\n              box-shadow var(--dur-fast) var(--ease-out);\n}\n.pd-input::placeholder { color: var(--fg-4); }\n.pd-input:focus {\n  outline: none;\n  border-color: var(--pd-green);\n  box-shadow: var(--shadow-focus);\n}\n\n/* =========================================================================\n   Badges / pills\n   ========================================================================= */\n\n.pd-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  height: 22px;\n  padding: 0 8px;\n  border-radius: var(--r-full);\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: 0.02em;\n  background: var(--pd-ink-50);\n  color: var(--fg-2);\n}\n.pd-badge--live {\n  background: #0A0A0A;\n  color: #fff;\n}\n.pd-badge--live::before {\n  content: '';\n  width: 6px; height: 6px;\n  border-radius: 50%;\n  background: var(--pd-green);\n  box-shadow: 0 0 0 0 var(--pd-green);\n  animation: pd-pulse 1.2s ease-in-out infinite;\n}\n.pd-badge--success { background: var(--pd-green-50); color: var(--pd-green-700); }\n.pd-badge--warn { background: #FFF4E0; color: #8A5A00; }\n.pd-badge--error { background: #FDECEE; color: #9B1C24; }\n\n@keyframes pd-pulse {\n  0%, 100% { transform: scale(0.85); opacity: 0.6; }\n  50%      { transform: scale(1.15); opacity: 1; }\n}\n\n/* =========================================================================\n   Chart reset helpers\n   ========================================================================= */\n\n.pd-chart-axis { font-size: 11px; fill: var(--fg-3); font-family: var(--font-body); }\n.pd-chart-grid { stroke: var(--chart-grid); stroke-dasharray: 0; }\n<\u002Fstyle>\n<style>\n  body { background: var(--bg-app); }\n  .pd-icon { display:inline-block; vertical-align:middle; }\n<\u002Fstyle>\n<\u002Fhead>\n<body>\n<!-- Inline icon sprite (referenced by <Icon id=\"...\"/> via #id) -->\n<svg xmlns=\"http://www.w3.org/2000/svg\" style=\"display:none\" aria-hidden=\"true\">\n  <symbol id=\"activity\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 12h-4l-3 9L9 3l-3 9H2\"><\u002Fpath><\u002Fsymbol>\n  <symbol id=\"dashboard\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"9\" rx=\"1.5\"><\u002Frect><rect x=\"14\" y=\"3\" width=\"7\" height=\"5\" rx=\"1.5\"><\u002Frect><rect x=\"14\" y=\"12\" width=\"7\" height=\"9\" rx=\"1.5\"><\u002Frect><rect x=\"3\" y=\"16\" width=\"7\" height=\"5\" rx=\"1.5\"><\u002Frect><\u002Fsymbol>\n  <symbol id=\"athletes\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"><\u002Fpath><circle cx=\"9\" cy=\"7\" r=\"4\"><\u002Fcircle><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"><\u002Fpath><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"><\u002Fpath><\u002Fsymbol>\n  <symbol id=\"chart\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 3v17a1 1 0 0 0 1 1h17\"><\u002Fpath><path d=\"M7 15l4-4 3 3 5-6\"><\u002Fpath><\u002Fsymbol>\n  <symbol id=\"chat\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"><\u002Fpath><\u002Fsymbol>\n  <symbol id=\"search\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"11\" cy=\"11\" r=\"7\"><\u002Fcircle><path d=\"m20 20-3.5-3.5\"><\u002Fpath><\u002Fsymbol>\n  <symbol id=\"filter\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 5h18l-7 9v6l-4-2v-4z\"><\u002Fpath><\u002Fsymbol>\n  <symbol id=\"bell\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9\"><\u002Fpath><path d=\"M10.3 21a1.94 1.94 0 0 0 3.4 0\"><\u002Fpath><\u002Fsymbol>\n  <symbol id=\"settings\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"3\"><\u002Fcircle><path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h.01a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v.01a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z\"><\u002Fpath><\u002Fsymbol>\n  <symbol id=\"play\" viewBox=\"0 0 24 24\" fill=\"currentColor\" stroke=\"none\"><path d=\"M6 4l14 8-14 8z\"><\u002Fpath><\u002Fsymbol>\n  <symbol id=\"stop\" viewBox=\"0 0 24 24\" fill=\"currentColor\" stroke=\"none\"><rect x=\"6\" y=\"6\" width=\"12\" height=\"12\" rx=\"2\"><\u002Frect><\u002Fsymbol>\n  <symbol id=\"heart\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"><\u002Fpath><\u002Fsymbol>\n  <symbol id=\"trophy\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0z\"><\u002Fpath><path d=\"M17 5h3v3a3 3 0 0 1-3 3M7 5H4v3a3 3 0 0 0 3 3\"><\u002Fpath><\u002Fsymbol>\n  <symbol id=\"watch\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"6\"><\u002Fcircle><path d=\"M12 10v2l1.5 1.5M9 2h6l1 4H8zM9 22h6l1-4H8z\"><\u002Fpath><\u002Fsymbol>\n  <symbol id=\"calendar\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\"><\u002Frect><path d=\"M16 2v4M8 2v4M3 10h18\"><\u002Fpath><\u002Fsymbol>\n  <symbol id=\"download\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3\"><\u002Fpath><\u002Fsymbol>\n  <symbol id=\"plus\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 5v14M5 12h14\"><\u002Fpath><\u002Fsymbol>\n  <symbol id=\"close\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 6 6 18M6 6l12 12\"><\u002Fpath><\u002Fsymbol>\n  <symbol id=\"chevron-right\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m9 6 6 6-6 6\"><\u002Fpath><\u002Fsymbol>\n  <symbol id=\"chevron-down\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"><\u002Fpath><\u002Fsymbol>\n  <symbol id=\"arrow-up\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 19V5M5 12l7-7 7 7\"><\u002Fpath><\u002Fsymbol>\n  <symbol id=\"send\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m22 2-7 20-4-9-9-4z\"><\u002Fpath><path d=\"M22 2 11 13\"><\u002Fpath><\u002Fsymbol>\n  <symbol id=\"sparkles\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3l1.9 4.8L18.8 10l-4.9 2.2L12 17l-1.9-4.8L5.2 10l4.9-2.2z\"><\u002Fpath><path d=\"M19 14l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8zM5 3l.6 1.5L7 5l-1.4.5L5 7l-.6-1.5L3 5l1.4-.5z\"><\u002Fpath><\u002Fsymbol>\n  <symbol id=\"flag\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 21V4M4 4h13l-2 5 2 5H4\"><\u002Fpath><\u002Fsymbol>\n<\u002Fsvg>\n\n<div id=\"root\"><\u002Fdiv>\n\n<script src=\"73197862-c3c9-4ec5-8bc4-57983c013038\" integrity=\"sha384-hD6/rw4ppMLGNu3tX5cjIb+uRZ7UkRJ6BPkLpg4hAu/6onKUg4lLsHAs9EBPT82L\" crossorigin=\"anonymous\"><\u002Fscript>\n<script src=\"f84e9380-8e17-404e-b646-b3d9a625be96\" integrity=\"sha384-u6aeetuaXnQ38mYT8rp6sbXaQe3NL9t+IBXmnYxwkUI2Hw4bsp2Wvmx4yRQF1uAm\" crossorigin=\"anonymous\"><\u002Fscript>\n<script src=\"c7086ef3-e94b-4352-838e-43597c59dc28\" integrity=\"sha384-m08KidiNqLdpJqLq95G/LEi8Qvjl/xUYll3QILypMoQ65QorJ9Lvtp2RXYGBFj1y\" crossorigin=\"anonymous\"><\u002Fscript>\n\n<script type=\"text/babel\" src=\"4e62916c-255e-4d81-bc61-740b0be93152\"><\u002Fscript>\n<script type=\"text/babel\" src=\"c4512966-fb41-447b-99ff-bf23ef08f7f5\"><\u002Fscript>\n<script type=\"text/babel\" src=\"8f0150c7-d36b-43d6-8d61-ce4c1fcd6cbd\"><\u002Fscript>\n<script type=\"text/babel\" src=\"c7b77618-35b6-4c3c-9159-1e6d3c7af55d\"><\u002Fscript>\n<script type=\"text/babel\" src=\"46c59cb3-4063-4609-9a1e-8e61f2c3e812\"><\u002Fscript>\n<script type=\"text/babel\" src=\"a86434d8-cb71-4aab-8921-90f7dfb21b70\"><\u002Fscript>\n<script type=\"text/babel\" src=\"7de87e40-1b40-4ce9-bbda-50c0569dbc7b\"><\u002Fscript>\n\n<script type=\"text/babel\">\nconst { useState } = React;\n\nconst TABS = [\n  { id:'overview',  label:'Overview',       icon:'dashboard' },\n  { id:'age',       label:'Age Group',      icon:'chart' },\n  { id:'athlete',   label:'Athlete',        icon:'athletes' },\n  { id:'benchmark', label:'Benchmarks',     icon:'trophy' },\n  { id:'chat',      label:'Chat',           icon:'chat' },\n];\n\nfunction App() {\n  const [active, setActive] = useState(() => localStorage.getItem('pd-tab') || 'overview');\n  const [filters, setFilters] = useState({\n    source:'Sample + Synthetic', gender:'All', sports:['Assoc. Football','American Football','Basketball','Lacrosse'],\n    divisions:['DI','DII','DIII'], ageMin:17, ageMax:24, minMinutes:70\n  });\n  const [selectedAthlete, setSelectedAthlete] = useState(1042);\n  const [chatAthlete, setChatAthlete] = useState(1042);\n\n  const changeTab = (id) => { setActive(id); localStorage.setItem('pd-tab', id); };\n\n  const sidebar = active === 'athlete'\n    ? <AthleteList selected={selectedAthlete} onSelect={setSelectedAthlete}/>\n    : <Sidebar filters={filters} setFilters={setFilters}/>;\n\n  return (\n    <Shell tabs={TABS} active={active} onChange={changeTab} sidebar={sidebar}>\n      <div style={{display:'flex', alignItems:'flex-end', justifyContent:'space-between', marginBottom:18}}>\n        <div>\n          <h1 style={{margin:0}}>{\n            active==='overview' ? 'Team Overview' :\n            active==='age' ? 'Age Group Metrics' :\n            active==='athlete' ? 'Athlete Drilldown' :\n            active==='benchmark' ? 'Cross-Sport Benchmarks' :\n            'Performance Chat'\n          }<\u002Fh1>\n          <div style={{color:'var(--fg-3)', marginTop:6, fontSize:13}}>\n            {active==='chat'\n              ? 'Ask questions about any athlete in plain English.'\n              : `${filters.sports.length} sports · ${filters.divisions.join('/')} · ages ${filters.ageMin}–${filters.ageMax} · min ${filters.minMinutes} min`}\n          <\u002Fdiv>\n        <\u002Fdiv>\n        {active !== 'chat' && (\n          <div style={{display:'flex', gap:10}}>\n            <button className=\"pd-btn pd-btn--secondary pd-btn--sm\"><Icon id=\"calendar\" size={14}/> Last 30 days<\u002Fbutton>\n            <button className=\"pd-btn pd-btn--secondary pd-btn--sm\"><Icon id=\"download\" size={14}/> Export<\u002Fbutton>\n            <button className=\"pd-btn pd-btn--primary pd-btn--sm\"><Icon id=\"plus\" size={14}/> New session<\u002Fbutton>\n          <\u002Fdiv>\n        )}\n      <\u002Fdiv>\n\n      {active === 'overview' && <>\n        <KPIStrip kpis={[\n          { label:'Sessions',         value:'1,284', delta:'12% vs last month', deltaDir:'up' },\n          { label:'Unique Athletes',  value:'168' },\n          { label:'Avg Session Load', value:'428.6', delta:'±82 SD cohort', deltaDir:'flat' },\n          { label:'Avg Total Dist',   value:'7,214', unit:'m', delta:'1% vs last week', deltaDir:'up' },\n        ]}/>\n        <div style={{display:'grid', gridTemplateColumns:'1fr 1fr', gap:16, marginBottom:16}}>\n          <ChartCard title=\"Session Load Distribution\" subtitle=\"Box + outliers, by sport\"><SessionLoadBox/><\u002FChartCard>\n          <ChartCard title=\"Volume vs Intensity\" subtitle=\"active_minutes × session_load · size = distance\"><VolumeScatter/><\u002FChartCard>\n        <\u002Fdiv>\n        <ChartCard title=\"Distance Breakdown\" subtitle=\"Mean total / high-intensity / sprint distance per sport\"><DistanceBars/><\u002FChartCard>\n      <\u002F>}\n\n      {active === 'age' && <>\n        <div style={{color:'var(--fg-3)', fontSize:13, marginBottom:14}}>\n          <b style={{color:'var(--fg-1)'}}>Source:<\u002Fb> DS team pipeline (<code>r_pipeline.txt<\u002Fcode>) · filtered to <code>active_minutes ≥ {filters.minMinutes}<\u002Fcode>, grouped by age.\n        <\u002Fdiv>\n        <ChartCard title=\"Total Distance by Age Group\" subtitle=\"Mean ±1 SD with 10/90 percentile markers\"><AgeGroupLine/><\u002FChartCard>\n        <div style={{height:16}}/>\n        <ChartCard title=\"Age-Group Summary Table\" subtitle=\"DS averages\">\n          <table style={{width:'100%', borderCollapse:'collapse', fontSize:12.5, fontVariantNumeric:'tabular-nums'}}>\n            <thead><tr>{['Age','N','Avg Distance','SD','P10','P90','Avg Load'].map(h => (\n              <th key={h} style={{textAlign:'left', padding:'8px 10px', color:'var(--fg-3)', fontSize:11, letterSpacing:'.04em', textTransform:'uppercase', borderBottom:'1px solid var(--pd-ink-100)'}}>{h}<\u002Fth>\n            ))}<\u002Ftr><\u002Fthead>\n            <tbody>{[\n              [17,22,6200,420,5450,7100,392],\n              [18,28,6650,480,5880,7650,415],\n              [19,34,7100,540,6240,8150,442],\n              [20,31,7380,510,6520,8350,461],\n              [21,26,7420,520,6540,8380,458],\n              [22,18,7210,470,6330,8250,440],\n              [23,9, 7010,440,6050,8010,432],\n            ].map(r => <tr key={r[0]}>{r.map((c,i) => (\n              <td key={i} style={{padding:'9px 10px', borderBottom:'1px solid var(--pd-ink-50)', color: i===0?'var(--fg-1)':'var(--fg-2)', fontWeight: i===0?600:500}}>{typeof c === 'number' && c > 999 ? c.toLocaleString() : c}<\u002Ftd>\n            ))}<\u002Ftr>)}<\u002Ftbody>\n          <\u002Ftable>\n        <\u002FChartCard>\n      <\u002F>}\n\n      {active === 'athlete' && <AthletePanel athleteId={selectedAthlete}/>}\n\n      {active === 'benchmark' && <>\n        <ChartCard title=\"Sport Benchmark Heatmap\" subtitle=\"Mean performance metrics · values raw, color normalized\"><BenchmarkHeatmap/><\u002FChartCard>\n      <\u002F>}\n\n      {active === 'chat' && <ChatBot athleteId={chatAthlete} setAthleteId={setChatAthlete}/>}\n    <\u002FShell>\n  );\n}\n\nReactDOM.createRoot(document.getElementById('root')).render(<App/>);\n<\u002Fscript>\n\n\n\n<\u002Fbody><\u002Fhtml>"
